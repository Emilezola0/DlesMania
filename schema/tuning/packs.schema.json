{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "packSize": {
      "type": "integer",
      "minimum": 1,
      "description": "Cards per pack",
      "maximum": 10
    },
    "odds": {
      "type": "object",
      "properties": {
        "common": {
          "type": "number",
          "minimum": 0
        },
        "rare": {
          "type": "number",
          "minimum": 0
        },
        "epic": {
          "type": "number",
          "minimum": 0
        },
        "legendary": {
          "type": "number",
          "minimum": 0
        },
        "mythic": {
          "type": "number",
          "minimum": 0
        },
        "omni": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "common",
        "rare",
        "epic",
        "legendary",
        "mythic",
        "omni"
      ],
      "additionalProperties": false,
      "title": "Base odds (%)",
      "description": "Per card; must add up to 100",
      "x-sumTo": 100
    },
    "topCap": {
      "type": "object",
      "properties": {
        "legendary": {
          "type": "number",
          "minimum": 0
        },
        "mythic": {
          "type": "number",
          "minimum": 0
        },
        "omni": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "legendary",
        "mythic",
        "omni"
      ],
      "additionalProperties": false,
      "title": "Top caps (%)",
      "description": "Never more than this, whatever stacks up"
    },
    "boost": {
      "type": "object",
      "properties": {
        "easy": {
          "type": "number",
          "minimum": 1
        },
        "medium": {
          "type": "number",
          "minimum": 1
        },
        "hard": {
          "type": "number",
          "minimum": 1
        },
        "hell": {
          "type": "number",
          "minimum": 1
        }
      },
      "required": [
        "easy",
        "medium",
        "hard",
        "hell"
      ],
      "additionalProperties": false,
      "title": "Franchise pack boost",
      "description": "By the hardest difficulty its boss was beaten at"
    },
    "general": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "cost": {
          "type": "integer",
          "minimum": 0
        },
        "icon": {
          "type": "string"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "x-widget": "color"
          },
          "minItems": 2,
          "maxItems": 2,
          "x-widget": "colors"
        }
      },
      "required": [
        "name",
        "blurb",
        "cost",
        "icon",
        "colors"
      ],
      "additionalProperties": false,
      "title": "General pack"
    },
    "domain": {
      "type": "object",
      "properties": {
        "cost": {
          "type": "integer",
          "minimum": 0
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "games",
                  "anime",
                  "cinema"
                ]
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "colors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "x-widget": "color"
                },
                "minItems": 2,
                "maxItems": 2,
                "x-widget": "colors"
              }
            },
            "required": [
              "domain",
              "name",
              "icon",
              "colors"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cost",
        "packs"
      ],
      "additionalProperties": false,
      "title": "Domain packs"
    },
    "cosmic": {
      "type": "object",
      "title": "Cosmic events",
      "description": "Rolled per pack as it is bought (so skipping the animation loses nothing): two planets embrace and its best card goes up a rarity or two, a supernova turns it Mythic, a Big Bang turns a Legendary Omni.",
      "properties": {
        "collision": { "type": "number", "minimum": 0, "maximum": 1, "description": "Chance a pack whose best card is Rare or Epic sees two planets embrace: Rare becomes Epic (or Legendary), Epic becomes Legendary" },
        "collisionToLegendary": { "type": "number", "minimum": 0, "maximum": 1, "description": "When a Rare's planets embrace: the chance it goes straight to Legendary instead of Epic" },
        "supernova": { "type": "number", "minimum": 0, "maximum": 1, "description": "Chance a pack's best card (below Mythic) is swallowed by a supernova and comes back Mythic" },
        "bigBang": { "type": "number", "minimum": 0, "maximum": 1, "description": "Chance a pack with a Legendary sees a Big Bang: the Legendary is reborn Omni" },
        "wish": { "type": "number", "minimum": 0, "maximum": 1, "description": "Chance a golden comet catches one of a pack's smaller stars (Common or Rare, never its best card) on its way: a Common becomes Rare" },
        "wishToEpic": { "type": "number", "minimum": 0, "maximum": 1, "description": "When the wish falls on a Rare: the chance it comes true (the Rare becomes Epic)" },
        "deepFake": { "type": "number", "minimum": 0, "maximum": 1, "description": "Looks only: when a Legendary or better poses as a lower rarity before evolving mid-flight, the chance it poses as two rarities lower (a Legendary tearing the pack open blue)" },
        "skyMoment": { "type": "number", "minimum": 0, "maximum": 1, "description": "Looks only: the chance a pack's sky has a moment of its own (a comet, a meteor shower, or the planet in the corner catching a moon)" }
      },
      "required": ["collision", "collisionToLegendary", "supernova", "bigBang", "wish", "wishToEpic", "deepFake", "skyMoment"],
      "additionalProperties": false
    },
    "franchise": {
      "type": "object",
      "properties": {
        "cost": {
          "type": "integer",
          "minimum": 0
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "x-widget": "color",
          "description": "Used when the guardian has no colour"
        },
        "secondColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "x-widget": "color"
        }
      },
      "required": [
        "cost",
        "icon",
        "color",
        "secondColor"
      ],
      "additionalProperties": false,
      "title": "Franchise packs"
    }
  },
  "required": [
    "cosmic",
    "packSize",
    "odds",
    "topCap",
    "boost",
    "general",
    "domain",
    "franchise"
  ],
  "additionalProperties": false,
  "title": "Packs"
}
