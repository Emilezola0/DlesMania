      "type": "object",
      "title": "Quests",
      "description": "Three quests at a time (Easy, Medium, Hard): a claimed one is replaced by another of its tier, and all of them change every day. Their progress counts from when each quest came up.",
      "properties": {
        "fullPerDay": {
          "type": "integer",
          "minimum": 0,
          "description": "Quests of each tier a day paid in full"
        },
        "afterFull": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the reward after that"
        },
