                "minimum": 1,
                "description": "DleCoins"
              }
            },
            "required": [
              "kind",
              "icon",
              "text",
              "need",
              "reward"
            ],
            "additionalProperties": false
          },
          "description": "Easy quests: one is drawn at a time, never the same goal twice in a row"
