        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "hard": {
          "type": "integer",
          "minimum": 125,
          "description": "The owner wants Hard at 125 or more"
        },
        "hell": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "easy",
        "medium",
        "hard",
        "hell"
