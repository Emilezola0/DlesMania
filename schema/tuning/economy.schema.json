    "round": {
      "type": "object",
      "properties": {
        "win": {
          "type": "integer",
          "minimum": 0,
          "description": "A won daily round, before the score bonus"
        },
        "perTenPoints": {
          "type": "integer",
          "minimum": 0,
          "description": "Added for every 10 points of score"
        },
        "loss": {
          "type": "integer",
          "minimum": 0,
          "description": "A lost daily round"
        }
      },
      "required": [
        "win",
        "perTenPoints",
        "loss"
      ],
      "additionalProperties": false,
      "title": "Daily rounds"
    },
    "categoryBonus": {
      "type": "integer",
      "minimum": 0,
      "description": "All ten rounds of a category played"
    },
    "bossWin": {
