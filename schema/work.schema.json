{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnidle.local/schema/work.schema.json",
  "title": "Omnidle work",
  "description": "One guessable work (game, anime, film or album). Files in src/data/works/*.json are arrays of these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "domain", "year", "genres", "studio", "creator", "origin", "format", "credits"],
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "items": { "$ref": "#/definitions/nonEmpty" } },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wiki": { "$ref": "#/definitions/nonEmpty", "description": "English Wikipedia article title; scripts/enrich-media.mjs resolves it to `image`." },
        "image": { "type": "string", "format": "uri" }
      }
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmpty" },
        "description": { "$ref": "#/definitions/nonEmpty" },
        "wiki": { "$ref": "#/definitions/nonEmpty" },
        "image": { "type": "string", "format": "uri" },
        "src": { "$ref": "#/definitions/nonEmpty", "description": "fandom:<wiki>[:<Title>], wp:<Title>, a URL, or \"none\" to keep the clue text-only; resolved to `image` by scripts/enrich-media.mjs." },
        "focus": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 100 }, "description": "Location zoom focal point [x%, y%]." }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[gacm]-[a-z0-9-]+$", "description": "Domain prefix (g/a/c/m) + slug." },
    "name": { "$ref": "#/definitions/nonEmpty" },
    "nameFr": { "$ref": "#/definitions/nonEmpty", "description": "French release title, when it differs. Accepted as an answer and shown in autocomplete." },
    "subtitle": { "$ref": "#/definitions/nonEmpty", "description": "Shown in autocomplete, e.g. the artist of an album." },
    "aliases": { "$ref": "#/definitions/stringList" },
    "domain": { "enum": ["games", "anime", "cinema", "music"] },
    "year": { "type": "integer", "minimum": 1880, "maximum": 2100 },
    "genres": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/nonEmpty" } },
    "studio": { "$ref": "#/definitions/nonEmpty", "description": "Studio, developer, publisher or label." },
    "creator": { "$ref": "#/definitions/nonEmpty", "description": "Director, lead designer, mangaka or artist." },
    "origin": { "$ref": "#/definitions/nonEmpty" },
    "format": { "$ref": "#/definitions/nonEmpty" },
    "source": { "$ref": "#/definitions/nonEmpty", "description": "Anime: Manga, Original, Light Novel..." },
    "platforms": { "$ref": "#/definitions/stringList", "description": "Games: PC, PlayStation, Xbox, Nintendo, Sega, Mobile, Arcade." },
    "characters": { "$ref": "#/definitions/stringList" },
    "themes": { "$ref": "#/definitions/stringList" },
    "credits": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/nonEmpty" } },
    "fandom": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Fandom wiki slug, e.g. \"zelda\" for zelda.fandom.com; item/location images are searched there." },
    "cover": { "$ref": "#/definitions/media" },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "$ref": "#/definitions/nonEmpty" }, "speaker": { "$ref": "#/definitions/nonEmpty" } }
    },
    "tracks": { "$ref": "#/definitions/stringList", "description": "Albums (no longer used for music): track titles, ordered from deep cut to biggest hit." },
    "facts": { "$ref": "#/definitions/stringList", "description": "Music: written clues about the song, vaguest first (where it comes from, then its artist), revealed one per miss in the Quote round." },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clue"],
      "properties": {
        "clue": { "$ref": "#/definitions/nonEmpty" },
        "youtubeId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "start": { "type": "number", "minimum": 0 },
        "query": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker"],
      "description": "Voice game: a character's original voice acting (no music). `query` finds a clip; `start` is the second the line begins.",
      "properties": {
        "speaker": { "$ref": "#/definitions/nonEmpty", "description": "Whose voice it is; revealed as the last hint." },
        "youtubeId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "start": { "type": "number", "minimum": 0 },
        "query": { "$ref": "#/definitions/nonEmpty" },
        "lang": { "enum": ["fr"], "description": "Set when the clip is the French dub (VF), used only when no Japanese clip was found." }
      }
    },
    "emoji": { "$ref": "#/definitions/nonEmpty" },
    "item": { "$ref": "#/definitions/clue" },
    "location": { "$ref": "#/definitions/clue" },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "colors"],
      "properties": {
        "icon": { "$ref": "#/definitions/nonEmpty" },
        "colors": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } }
      }
    }
  }
}
