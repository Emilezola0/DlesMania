{
  "rules": {
    ".read": false,
    ".write": false,
    "here": {
      "$owner": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'x', 'y', 'left', 'at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "face": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 200"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 200"
          },
          "left": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "tool": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "pose": {
            ".validate": "newData.isString() && newData.val().matches(/^(sit|sleep|cart|zip)$/)"
          },
          "world": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "tv": {
            ".validate": "newData.hasChildren(['cell', 'at', 'on'])",
            "cell": {
              ".validate": "newData.isNumber()"
            },
            "card": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "clip": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "tune": {
            ".validate": "newData.hasChildren(['key', 'at'])",
            "key": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "value": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "emote": {
            ".validate": "newData.hasChildren(['e', 'at'])",
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "dmobs": {
      "$owner": {
        "$week": {
          ".read": "auth != null",
          "$mob": {
            ".write": "auth != null && $week.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $mob.matches(/^(boss|[0-9]+-[0-9]+-[0-9]+)$/)",
            ".validate": "newData.hasChildren(['hp'])",
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "dead": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "fallen": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "hitters": {
              "$uid": {
                ".validate": "newData.isBoolean()"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "isles": {
      "$owner": {
        ".read": "auth != null && (auth.uid === $owner || root.child('isles').child($owner).child('friends').child(auth.uid).exists() || root.child('isles').child($owner).child('builders').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $owner",
        "owner": {
          ".validate": "newData.val() === $owner"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "builders": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "friends": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "state": {
          ".write": "auth != null && root.child('isles').child($owner).child('builders').child(auth.uid).exists()",
          "island": {
            ".validate": "newData.isString() && newData.val().length < 3000000"
          },
          "plots": {
            "$cell": {
              ".write": "auth != null && data.exists() && newData.exists() && root.child('isles').child($owner).child('friends').child(auth.uid).exists()",
              ".validate": "$cell.matches(/^c[0-9]+$/) && newData.isString() && newData.val().length <= 2000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "log": {
          "$id": {
            ".write": "auth != null && !data.exists() && (root.child('isles').child($owner).child('friends').child(auth.uid).exists() || root.child('isles').child($owner).child('builders').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['uid', 'name', 'what', 'day']) && (newData.child('uid').val() === auth.uid || auth.uid === $owner)",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "what": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "day": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "teams": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{8}$/) && !data.exists() && newData.child('members').child(auth.uid).exists()",
        "name": {
          ".write": "auth != null && root.child('teams').child($code).child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.parent().parent().child('createdBy').exists()",
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "state": {
          ".write": "auth != null && root.child('teams').child($code).child('members').child(auth.uid).exists()",
          "island": {
            ".validate": "newData.isString() && newData.val().length < 3000000"
          },
          "plots": {
            "$cell": {
              ".validate": "$cell.matches(/^c[0-9]+$/) && newData.isString() && newData.val().length <= 2000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "log": {
          "$id": {
            ".write": "auth != null && root.child('teams').child($code).child('members').child(auth.uid).exists() && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['uid', 'name', 'what', 'day']) && (newData.child('uid').val() === auth.uid || !root.child('teams').child($code).exists())",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "what": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "day": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "teamOf": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8}$/)"
      }
    }
  }
}
