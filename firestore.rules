rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own save: saves/<uid> and its months.
    match /saves/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Trades (src/cloud/trades.ts). Any signed-in player can look an offer up by its code; only its
    // maker can open or cancel it and collect what came back; only someone else can take it. An offer holds
    // up to 5 cards and 500,000 DleCoins a side (economy.json trades). Offers made before coins came in hold
    // one card each way (give a string, want a string or null) and are still taken the old way.
    match /trades/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.give is list && request.resource.data.give.size() <= 5
        && request.resource.data.want is list && request.resource.data.want.size() <= 5
        && request.resource.data.wantAny is bool
        && request.resource.data.giveCoins is int && request.resource.data.giveCoins >= 0 && request.resource.data.giveCoins <= 500000
        && request.resource.data.wantCoins is int && request.resource.data.wantCoins >= 0 && request.resource.data.wantCoins <= 500000
        && (request.resource.data.give.size() > 0 || request.resource.data.giveCoins > 0)
        && (request.resource.data.want.size() > 0 || request.resource.data.wantAny || request.resource.data.wantCoins > 0);
      allow update: if request.auth != null && (
        // The maker cancels an offer nobody took, or collects what came back.
        (resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && ((resource.data.status == 'open' && request.resource.data.status == 'cancelled')
              || (resource.data.status == 'accepted' && request.resource.data.status == 'claimed')))
        // Someone else takes an open offer, with the cards it asks for.
        || (resource.data.from != request.auth.uid && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'to', 'toName', 'got'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.to == request.auth.uid
          && (
            (resource.data.give is string
              && request.resource.data.got is string
              && (resource.data.want == null || request.resource.data.got == resource.data.want))
            || (resource.data.give is list
              && request.resource.data.got is list
              && request.resource.data.got.hasAll(resource.data.want)
              && ((resource.data.wantAny && request.resource.data.got.size() == resource.data.want.size() + 1)
                  || (!resource.data.wantAny && request.resource.data.got.size() == resource.data.want.size())))
          ))
      );
    }

    // Curve Clash online (src/cloud/clash.ts): any signed-in player can look a game up and join it
    // while it has one player; only its two players can play it. Its field and players never change.
    match /clash/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null;
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && request.resource.data.seed == resource.data.seed
        && (
          (resource.data.guest == null && request.resource.data.guest == request.auth.uid)
          || ((request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
              && request.resource.data.guest == resource.data.guest)
        );
    }

    // Completed albums (src/cloud/albums.ts), told to every player: anyone can read them (players
    // without an account too); each signed-in player writes only their own, with the time it happened.
    match /albums/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'cards', 'at'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.cards is int
        && request.resource.data.at is int
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000;
    }

    // Friends and their collection scores (src/cloud/friends.ts). A friend code finds its player
    // (signed-in players look codes up; only its player makes or drops one); whoever adds a friend
    // leaves a note under the code, proof they had it.
    match /friendcodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /friendcodes/{code}/joins/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']);
    }
    // A score is read only by its player and their friends. Its player writes it; another player
    // only adds themselves to its friends (with a note under its current code, made in the same
    // write) or takes themselves off: friends are mutual.
    function scoreShapeOk(d) {
      return d.keys().hasOnly(['uid', 'name', 'avatar', 'frame', 'nameStyle', 'title', 'plush', 'code', 'friends', 'log', 'at'])
        && d.name is string && d.name.size() <= 40
        && (!('nameStyle' in d) || d.nameStyle == null || (d.nameStyle is string && d.nameStyle.size() <= 40))
        && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 40))
        && (!('plush' in d) || d.plush == null || (d.plush is string && d.plush.size() <= 40))
        && d.code is string && d.code.size() == 8
        && d.friends is list && d.friends.size() <= 30
        && d.log is map;
    }
    match /scores/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid in resource.data.friends);
      allow create: if request.auth != null && request.auth.uid == uid
        && scoreShapeOk(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.friends.size() == 0;
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && scoreShapeOk(request.resource.data)
          && request.resource.data.uid == uid)
        || (request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
          && request.resource.data.friends.size() <= 30
          && (
            // Joining: themselves added, nobody else, with proof they had the code.
            (request.resource.data.friends.toSet() == resource.data.friends.toSet().union([request.auth.uid].toSet())
              && existsAfter(/databases/$(database)/documents/friendcodes/$(resource.data.code)/joins/$(request.auth.uid)))
            // Leaving: themselves taken off, nobody else.
            || request.resource.data.friends.toSet() == resource.data.friends.toSet().difference([request.auth.uid].toSet())
          ))
      );
    }

    // The Daily Doodle (src/cloud/doodles.ts): doodles/<uid>_<day>. Its artist posts it once; only they and
    // their friends (their scores document's list) can read it. A friend guesses up to 3 times (their own
    // note under guesses/); a right guess adds them, and only them, to its solvers, in the same write.
    match /doodles/{id} {
      function artist() {
        return id.split('_')[0];
      }
      function isFriend() {
        return request.auth.uid in get(/databases/$(database)/documents/scores/$(artist())).data.friends;
      }
      allow get: if request.auth != null && (request.auth.uid == artist() || isFriend());
      allow create: if request.auth != null && request.auth.uid == artist()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'set', 'secs', 'answer', 'strokes', 'solvers', 'at'])
        && request.resource.data.uid == artist()
        && id == artist() + '_' + request.resource.data.day
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.secs in [10, 20, 30]
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 64
        && request.resource.data.strokes is list && request.resource.data.strokes.size() <= 400
        && request.resource.data.solvers.size() == 0;
      allow update: if request.auth != null && request.auth.uid != artist() && isFriend()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solvers'])
        && request.resource.data.solvers.toSet() == resource.data.solvers.toSet().union([request.auth.uid].toSet())
        && getAfter(/databases/$(database)/documents/doodles/$(id)/guesses/$(request.auth.uid)).data.right == true;
      match /guesses/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && uid != artist() && isFriend()
          && request.resource.data.keys().hasOnly(['tries', 'right', 'at'])
          && request.resource.data.tries == 1 && request.resource.data.right is bool;
        allow update: if request.auth != null && request.auth.uid == uid
          && resource.data.right == false
          && request.resource.data.keys().hasOnly(['tries', 'right', 'at'])
          && request.resource.data.tries == resource.data.tries + 1
          && request.resource.data.tries <= 3;
      }
    }

    // The Black Market's stalls (src/cloud/blackmarket.ts): blackmarket/<uid>/stalls/<id>, the Mythic and Omni
    // cards a player handed over in a trade. Only they and their friends can see them; they put them up (at the
    // server's time); a friend buys one within the week by writing their name on it, once.
    match /blackmarket/{uid}/stalls/{item} {
      function friendOf() {
        return request.auth.uid in get(/databases/$(database)/documents/scores/$(uid)).data.friends;
      }
      allow read: if request.auth != null && (request.auth.uid == uid || friendOf());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['seller', 'card', 'rarity', 'at', 'buyer', 'buyerName'])
        && request.resource.data.seller is string && request.resource.data.seller.size() <= 40
        && request.resource.data.card is string && request.resource.data.card.size() <= 80
        && request.resource.data.rarity in ['mythic', 'omni']
        && request.resource.data.at == request.time
        && request.resource.data.buyer == null && request.resource.data.buyerName == null;
      allow update: if request.auth != null && request.auth.uid != uid && friendOf()
        && resource.data.buyer == null
        && request.time < resource.data.at + duration.value(7, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyer', 'buyerName', 'boughtAt'])
        && request.resource.data.buyer == request.auth.uid
        && request.resource.data.buyerName is string && request.resource.data.buyerName.size() <= 40
        && request.resource.data.boughtAt == request.time;
    }

    // The luck report (src/cloud/luck.ts): luck/<uid>, the Legendary, Mythic and Omni cards a player's packs gave
    // and the ones their odds promised. Only they and their friends read it. Only they add to it, an opening at a
    // time (1 to 50 packs, the Shop's most at once: MAX_OPEN in src/pages/Shop.tsx; 5 cards a pack at most), never taking anything back, at the server's time.
    match /luck/{uid} {
      function luckShapeOk(d) {
        return d.keys().hasOnly(['packs', 'legendary', 'mythic', 'omni', 'eLegendary', 'eMythic', 'eOmni', 'since', 'at'])
          && d.packs is int && d.legendary is int && d.mythic is int && d.omni is int
          && d.eLegendary is number && d.eMythic is number && d.eOmni is number
          && d.at == request.time;
      }
      // What one opening added: `n` packs, cards and expected cards that only grow, within the pack's five cards.
      function addedOk(d, o, n) {
        return n >= 1 && n <= 50
          && d.legendary >= o.legendary && d.mythic >= o.mythic && d.omni >= o.omni
          && (d.legendary - o.legendary) + (d.mythic - o.mythic) + (d.omni - o.omni) <= n * 5
          && d.eLegendary >= o.eLegendary && d.eLegendary - o.eLegendary <= n * 5
          && d.eMythic >= o.eMythic && d.eMythic - o.eMythic <= n * 5
          && d.eOmni >= o.eOmni && d.eOmni - o.eOmni <= n * 5;
      }
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/scores/$(uid)).data.friends);
      allow create: if request.auth != null && request.auth.uid == uid
        && luckShapeOk(request.resource.data)
        && request.resource.data.since == request.time
        && addedOk(request.resource.data, { 'legendary': 0, 'mythic': 0, 'omni': 0, 'eLegendary': 0, 'eMythic': 0, 'eOmni': 0 }, request.resource.data.packs);
      allow update: if request.auth != null && request.auth.uid == uid
        && luckShapeOk(request.resource.data)
        && request.resource.data.since == resource.data.since
        && addedOk(request.resource.data, resource.data, request.resource.data.packs - resource.data.packs);
      // Its player can clear it (the Test Lab's reset): it starts again, with a new "since" date friends see.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The Daily Choice (src/cloud/choices.ts): choices/<uid>_<day>, the card a player picked for each of the day's
    // questions, and the one they think most of their friends picked ("read the room", guess). Only on that day (by
    // the server's clock, any time zone); a pick or a guess is made once and never changed or taken back (it's what
    // pays). Its player reads it; their friends too, once that day is over everywhere.
    match /choices/{id} {
      function voter() {
        return id.split('_')[0];
      }
      function dayOf() {
        return id.split('_')[1];
      }
      function dayStart() {
        return timestamp.date(int(dayOf().split('-')[0]), int(dayOf().split('-')[1]), int(dayOf().split('-')[2]));
      }
      function picksOk(p) {
        return p is map && p.size() <= 3 && p.keys().hasOnly(['0', '1', '2'])
          && (!('0' in p) || (p['0'] is string && p['0'].size() <= 80))
          && (!('1' in p) || (p['1'] is string && p['1'].size() <= 80))
          && (!('2' in p) || (p['2'] is string && p['2'].size() <= 80));
      }
      function onItsDay() {
        return dayOf().matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.time > dayStart() - duration.value(14, 'h')
          && request.time < dayStart() + duration.value(1, 'd') + duration.value(12, 'h');
      }
      allow get: if request.auth != null && (request.auth.uid == voter()
        || (request.time > dayStart() + duration.value(1, 'd') - duration.value(14, 'h')
          && request.auth.uid in get(/databases/$(database)/documents/scores/$(voter())).data.friends));
      // A map of picks (or guesses) that only grew by at most one, nothing in it changed or taken back.
      function grewByOne(n, o) {
        return n.diff(o).changedKeys().size() == 0 && n.diff(o).removedKeys().size() == 0 && n.diff(o).addedKeys().size() <= 1;
      }
      allow create: if request.auth != null && request.auth.uid == voter() && onItsDay()
        && request.resource.data.keys().hasOnly(['uid', 'day', 'picks', 'guess'])
        && request.resource.data.uid == voter() && request.resource.data.day == dayOf()
        && picksOk(request.resource.data.picks) && request.resource.data.picks.size() <= 1
        && (!('guess' in request.resource.data) || (picksOk(request.resource.data.guess) && request.resource.data.guess.size() <= 1))
        && request.resource.data.picks.size() + request.resource.data.get('guess', {}).size() >= 1;
      allow update: if request.auth != null && request.auth.uid == voter() && onItsDay()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'guess'])
        && picksOk(request.resource.data.picks)
        && grewByOne(request.resource.data.picks, resource.data.picks)
        && (!('guess' in request.resource.data) || (picksOk(request.resource.data.guess) && grewByOne(request.resource.data.guess, resource.data.get('guess', {}))));
    }

    // The Raid Boss (src/cloud/raids.ts): raidhits/<uid>_<week's Monday>, a player's attacks on the week's boss, one a
    // day. Each is added once (never changed or taken back), only on its day by the server's clock, inside its week,
    // at the server's time, at most 2,500 damage (RAID.maxHit, src/data/tuning/friends.json). Its player and their
    // friends read it.
    match /raidhits/{id} {
      function hitter() {
        return id.split('_')[0];
      }
      function weekOf() {
        return id.split('_')[1];
      }
      function dateOf(key) {
        return timestamp.date(int(key.split('-')[0]), int(key.split('-')[1]), int(key.split('-')[2]));
      }
      function hitOk(d, key) {
        return key.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.time > dateOf(key) - duration.value(14, 'h')
          && request.time < dateOf(key) + duration.value(1, 'd') + duration.value(12, 'h')
          && dateOf(key) >= dateOf(weekOf()) && dateOf(key) < dateOf(weekOf()) + duration.value(7, 'd')
          && d.hits[key] is map && d.hits[key].keys().hasOnly(['d', 'at'])
          && d.hits[key].d is int && d.hits[key].d >= 0 && d.hits[key].d <= 2500
          && d.hits[key].at == request.time;
      }
      allow get: if request.auth != null && (request.auth.uid == hitter()
        || request.auth.uid in get(/databases/$(database)/documents/scores/$(hitter())).data.friends);
      allow create: if request.auth != null && request.auth.uid == hitter()
        && weekOf().matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && dateOf(weekOf()).dayOfWeek() == 1
        && request.resource.data.keys().hasOnly(['uid', 'week', 'last', 'hits'])
        && request.resource.data.uid == hitter() && request.resource.data.week == weekOf()
        && request.resource.data.hits is map && request.resource.data.hits.keys().hasOnly([request.resource.data.last])
        && hitOk(request.resource.data, request.resource.data.last);
      allow update: if request.auth != null && request.auth.uid == hitter()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'hits'])
        && request.resource.data.hits.diff(resource.data.hits).changedKeys().size() == 0
        && request.resource.data.hits.diff(resource.data.hits).removedKeys().size() == 0
        && request.resource.data.hits.diff(resource.data.hits).addedKeys().hasOnly([request.resource.data.last])
        && request.resource.data.hits.diff(resource.data.hits).addedKeys().size() == 1
        && hitOk(request.resource.data, request.resource.data.last);
    }

    // Telephone (src/cloud/phones.ts): phones/<uid>_<day>, a daily drawing chain a player starts on its day with a name
    // (the server's clock); only they and their friends read it. It holds only each step's kind and maker: the steps are
    // sealed away in steps/<n>. A friend breaks the seal of the next turn once per chain (claim: theirs for 10 minutes,
    // TELEPHONE.claimMinutes) and only then reads the step before; they add theirs at the end while the chain is open
    // (7 steps, until its day ends: `ends`, midnight where its starter is): a drawing after a name, a guess after a
    // drawing. Nothing before it changes, and it can't be taken back. Once it's finished, the starter and their friends
    // read every step. A chain from before the seals (its steps inside it) is brought into this shape by its starter or a
    // friend, every step copied exactly, so nothing drawn is lost.
    match /phones/{id} {
      function starter() {
        return id.split('_')[0];
      }
      function dayStart() {
        return timestamp.date(int(id.split('_')[1].split('-')[0]), int(id.split('_')[1].split('-')[1]), int(id.split('_')[1].split('-')[2]));
      }
      function friendOfStarter() {
        return request.auth.uid in get(/databases/$(database)/documents/scores/$(starter())).data.friends;
      }
      function stepOk(s, kind) {
        return s is map && s.keys().hasOnly(['u', 'n', 'k', 't', 's'])
          && s.u == request.auth.uid && s.n is string && s.n.size() <= 40 && s.k == kind
          && (kind == 'd'
            ? (s.s is list && s.s.size() <= 400 && !('t' in s))
            : (s.t is string && s.t.size() > 0 && s.t.size() <= 64 && !('s' in s)));
      }
      function chainPath() {
        return /databases/$(database)/documents/phones/$(id);
      }
      // When its day ends: `ends` (its starter's midnight); for a chain without it, when the day is over everywhere.
      function endOf(c) {
        return ('ends' in c) ? c.ends : dayStart() + duration.value(1, 'd') + duration.value(12, 'h');
      }
      // A midnight at the end of the chain's day, in some time zone (UTC+14 to UTC-12).
      function endsOk(e) {
        return e is timestamp
          && e >= dayStart() + duration.value(1, 'd') - duration.value(14, 'h')
          && e <= dayStart() + duration.value(1, 'd') + duration.value(12, 'h');
      }
      // Full, or its day is over: the seals are off.
      function done(c) {
        return c.kinds.size() >= 7 || request.time > endOf(c);
      }
      // A step of a chain from before the seals, brought over: the same kind, its copy written in the same write.
      function migratedStep(i) {
        return i >= resource.data.steps.size()
          || (request.resource.data.kinds[i] == resource.data.steps[i].k
            && existsAfter(/databases/$(database)/documents/phones/$(id)/steps/$(string(i))));
      }
      // The kind of the step that comes after n steps: a drawing after a name or a guess, a guess after a drawing.
      function nextKind(n) {
        return n % 2 == 1 ? 'd' : 'g';
      }
      allow get: if request.auth != null && (request.auth.uid == starter() || friendOfStarter());
      // A new chain, with its first step.
      function newChainOk() {
        return request.auth.uid == starter()
          && id.split('_')[1].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.time > dayStart() - duration.value(14, 'h')
          && request.time < dayStart() + duration.value(1, 'd') + duration.value(12, 'h')
          && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'set', 'at', 'ends', 'kinds', 'people', 'seen', 'claim'])
          && request.resource.data.uid == starter() && request.resource.data.day == id.split('_')[1]
          && endsOk(request.resource.data.ends)
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.set is string && request.resource.data.set.size() <= 40
          && request.resource.data.at == request.time
          && request.resource.data.kinds == ['w']
          && request.resource.data.people == [starter()]
          && request.resource.data.seen == [] && request.resource.data.claim == null
          && existsAfter(/databases/$(database)/documents/phones/$(id)/steps/0);
      }
      allow create: if request.auth != null && newChainOk();
      // Bringing a chain from before the seals over (its starter or a friend): the same chain, its steps sealed away.
      allow update: if request.auth != null && (request.auth.uid == starter() || friendOfStarter())
        && !('kinds' in resource.data) && resource.data.steps is list && resource.data.steps.size() <= 7
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'set', 'at', 'ends', 'kinds', 'people', 'seen', 'claim'])
        && request.resource.data.uid == resource.data.uid && request.resource.data.name == resource.data.name
        && request.resource.data.day == resource.data.day && request.resource.data.set == resource.data.set
        && request.resource.data.at == resource.data.at
        && endsOk(request.resource.data.ends)
        && request.resource.data.people == resource.data.people
        && request.resource.data.seen == [] && request.resource.data.claim == null
        && request.resource.data.kinds.size() == resource.data.steps.size()
        && migratedStep(0) && migratedStep(1) && migratedStep(2) && migratedStep(3)
        && migratedStep(4) && migratedStep(5) && migratedStep(6);
      allow update: if request.auth != null && request.auth.uid != starter() && friendOfStarter()
        && !(request.auth.uid in resource.data.people)
        && !done(resource.data)
        && (
          // Breaking the seal: the turn is theirs (nobody holds it, or the one who did ran out of time), once per chain.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claim', 'seen'])
            && !(request.auth.uid in resource.data.seen) && resource.data.seen.size() < 40
            && (resource.data.claim == null || request.time > resource.data.claim.at + duration.value(10, 'm'))
            && request.resource.data.claim.keys().hasOnly(['u', 'at'])
            && request.resource.data.claim.u == request.auth.uid && request.resource.data.claim.at == request.time
            && request.resource.data.seen == resource.data.seen.concat([request.auth.uid]))
          // Playing it: their step, written under steps/ in the same write, at the end.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kinds', 'people', 'claim'])
            && resource.data.claim != null && resource.data.claim.u == request.auth.uid
            && request.resource.data.claim == null
            && request.resource.data.people == resource.data.people.concat([request.auth.uid])
            && request.resource.data.kinds == resource.data.kinds.concat([nextKind(resource.data.kinds.size())])
            && existsAfter(/databases/$(database)/documents/phones/$(id)/steps/$(string(resource.data.kinds.size()))))
        );
      match /steps/{n} {
        function chain() {
          return get(chainPath()).data;
        }
        function canSeeAll() {
          return (request.auth.uid == starter() || friendOfStarter()) && done(chain());
        }
        // Its maker; whoever broke the seal of the turn after it (the last step); everyone once the chain is finished.
        allow get: if request.auth != null && (resource.data.u == request.auth.uid
          || (chain().claim != null && chain().claim.u == request.auth.uid && !(request.auth.uid in chain().people)
            && int(n) == chain().kinds.size() - 1)
          || canSeeAll());
        allow list: if request.auth != null && canSeeAll();
        allow create: if request.auth != null && (
          // The first step, made with its chain.
          (n == '0' && request.auth.uid == starter() && !exists(chainPath())
            && getAfter(chainPath()).data.kinds == ['w']
            && stepOk(request.resource.data, 'w'))
          // A step of a chain from before the seals, brought over: an exact copy of it, made with the chain's update.
          || ((request.auth.uid == starter() || friendOfStarter())
            && exists(chainPath()) && !('kinds' in chain()) && chain().steps is list
            && int(n) < chain().steps.size()
            && request.resource.data == chain().steps[int(n)]
            && 'kinds' in getAfter(chainPath()).data)
          // A turn: by whoever holds it, right at the end, made with the chain's update.
          || (exists(chainPath()) && chain().claim != null && chain().claim.u == request.auth.uid
            && n == string(chain().kinds.size())
            && getAfter(chainPath()).data.kinds.size() == chain().kinds.size() + 1
            && stepOk(request.resource.data, nextKind(chain().kinds.size())))
        );
      }
    }

    // The Defence Deck (src/cloud/defences.ts): defences/<uid>, a player's five cards in order, set on its day (the
    // server's clock) and changed at most once a day; only they and their friends read it. Under it, attacks/<attacker>_<day>:
    // a friend's attack, made once a day on its day, at the server's time, kept for good; its defender lists them all, its
    // attacker reads their own.
    function teamCardOk(t) {
      return t is map && t.keys().hasOnly(['id', 'grade', 'element', 'anomaly'])
        && t.id is string && t.id.size() <= 80
        && t.grade is int && t.grade >= 1 && t.grade <= 8
        && t.element in ['water', 'air', 'fire', 'earth', 'light', 'darkness']
        && (t.anomaly == null || t.anomaly in ['corrupted', 'fake', 'inverted', 'mirror', 'timelost', 'void']);
    }
    function teamOk(team) {
      return team is list && team.size() == 5
        && teamCardOk(team[0]) && teamCardOk(team[1]) && teamCardOk(team[2]) && teamCardOk(team[3]) && teamCardOk(team[4]);
    }
    function isToday(day) {
      return day is string && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.time > timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2])) - duration.value(14, 'h')
        && request.time < timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2])) + duration.value(1, 'd') + duration.value(12, 'h');
    }
    match /defences/{uid} {
      function friendOf() {
        return request.auth.uid in get(/databases/$(database)/documents/scores/$(uid)).data.friends;
      }
      function defenceOk(d) {
        return d.keys().hasOnly(['uid', 'name', 'day', 'team', 'at'])
          && d.uid == uid && d.name is string && d.name.size() <= 40
          && isToday(d.day) && teamOk(d.team) && d.at == request.time;
      }
      allow get: if request.auth != null && (request.auth.uid == uid || friendOf());
      allow create: if request.auth != null && request.auth.uid == uid && defenceOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && defenceOk(request.resource.data)
        && request.resource.data.day != resource.data.day;
      match /attacks/{id} {
        function attacker() {
          return id.split('_')[0];
        }
        allow get: if request.auth != null && (request.auth.uid == uid || request.auth.uid == attacker());
        allow list: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == attacker() && attacker() != uid && friendOf()
          && id == attacker() + '_' + request.resource.data.day
          && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'won', 'team', 'def', 'at'])
          && request.resource.data.uid == attacker()
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && isToday(request.resource.data.day)
          && request.resource.data.won is bool
          && teamOk(request.resource.data.team) && teamOk(request.resource.data.def)
          && request.resource.data.at == request.time;
      }
    }

    // Group codes for the dailies (src/cloud/groups.ts). Anyone can look a code up (friends need no
    // account to join); a signed-in player makes their own; joining only counts one more friend, up to 12.
    match /groups/{code} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.joined == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined == resource.data.joined + 1
        && request.resource.data.joined <= 12;
    }

    // The daily gift, birthday and special-date rewards (src/cloud/rewards.ts). The birthday is written once and can
    // never be changed or removed; each reward is a claim document that can only be created once
    // (birthday-2026, christmas-2026...), at the server's time (the device's clock can't be faked in).
    // The coins are only added to the save after the claim was accepted. The dates here must match
    // src/data/rewards.json (npm run data:validate checks it).
    function rewardDates() {
      return { 'newyear': [1, 1], 'omnidle': [10, 18], 'halloween': [10, 31], 'christmas': [12, 25] };
    }
    // Days a special date's reward stays open (the day itself and the 6 after), as in rewards.json.
    function rewardWindowDays() {
      return 7;
    }
    // A day starts at UTC midnight; 14 hours early and 12 hours late cover every time zone.
    function hasBegun(t) {
      return request.time > t - duration.value(14, 'h');
    }
    function notOver(t) {
      return request.time < t + duration.value(12, 'h');
    }
    // A 29 February birthday falls on the 28th in other years.
    function birthdayIn(y, b) {
      return timestamp.date(y, b.month, (b.month == 2 && b.day == 29 && y % 4 != 0) ? 28 : b.day);
    }
    function birthdayClaimOk(uid, y) {
      return exists(/databases/$(database)/documents/rewards/$(uid))
        && hasBegun(birthdayIn(y, get(/databases/$(database)/documents/rewards/$(uid)).data))
        && notOver(timestamp.date(y + 1, 1, 1));
    }
    function dateClaimOk(name, y) {
      return name in rewardDates()
        && hasBegun(timestamp.date(y, rewardDates()[name][0], rewardDates()[name][1]))
        && notOver(timestamp.date(y, rewardDates()[name][0], rewardDates()[name][1]) + duration.value(rewardWindowDays(), 'd'));
    }
    // The daily gift (daily-2026-11-07): only on that day (by the server's clock, any time zone).
    function dailyClaimOk(id) {
      return id.matches('daily-[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && hasBegun(timestamp.date(int(id.split('-')[1]), int(id.split('-')[2]), int(id.split('-')[3])))
        && notOver(timestamp.date(int(id.split('-')[1]), int(id.split('-')[2]), int(id.split('-')[3])) + duration.value(1, 'd'));
    }
    // A gift code (src/cloud/rewards.ts claimCode): code-<id> once for good; a daily one, code-<id>-<YYYY-MM-DD>,
    // only on that day (by the server's clock, any time zone).
    function codeClaimOk(id) {
      return id.matches('code-[0-9a-f]{16}')
        || (id.matches('code-[0-9a-f]{16}-[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && hasBegun(timestamp.date(int(id.split('-')[2]), int(id.split('-')[3]), int(id.split('-')[4])))
          && notOver(timestamp.date(int(id.split('-')[2]), int(id.split('-')[3]), int(id.split('-')[4])) + duration.value(1, 'd')));
    }
    function claimOk(uid, id) {
      return dailyClaimOk(id)
        || codeClaimOk(id)
        || (id.matches('[a-z]+-[0-9]{4}')
          && (id.split('-')[0] == 'birthday'
            ? birthdayClaimOk(uid, int(id.split('-')[1]))
            : dateClaimOk(id.split('-')[0], int(id.split('-')[1]))));
    }
    // The commune (src/cloud/commune.ts): commune/<YYYY-MM-DD>/members/<uid>, a player's balance (doubled) put in the
    // day's pot by its gift code. Written once, by its player, only on its day (by the server's clock, any time zone),
    // at most 10,000,000 (COMMUNE_CAP); never changed or taken back. Every signed-in player reads the day's pot: each
    // one moves their own coins to its average.
    match /commune/{day}/members/{uid} {
      function dayStart() {
        return timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2]));
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && hasBegun(dayStart()) && notOver(dayStart() + duration.value(1, 'd'))
        && request.resource.data.keys().hasOnly(['uid', 'balance', 'at'])
        && request.resource.data.uid == uid
        && request.resource.data.balance is int && request.resource.data.balance >= 0 && request.resource.data.balance <= 10000000
        && request.resource.data.at == request.time;
      // No update, no delete: a place in the pot stays as it was put.
    }
    match /rewards/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['month', 'day', 'at'])
        && request.resource.data.month is int && request.resource.data.month >= 1 && request.resource.data.month <= 12
        && request.resource.data.day is int && request.resource.data.day >= 1
        && request.resource.data.day <= [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][request.resource.data.month - 1]
        && request.resource.data.at == request.time;
      // No update, no delete: the birthday is for good.
    }
    match /rewards/{uid}/claims/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && claimOk(uid, id);
      // No update, no delete: a reward claimed stays claimed.
    }
  }
}
