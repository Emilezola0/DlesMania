rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own save: saves/<uid> and its months.
    match /saves/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Card trades (src/cloud/trades.ts). Any signed-in player can look an offer up by its code;
    // only its maker can open or cancel it and collect what came back; only someone else can take it.
    match /trades/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if request.auth != null
        && request.resource.data.from == resource.data.from
        && request.resource.data.give == resource.data.give
        && request.resource.data.want == resource.data.want
        && (
          // The maker cancels an offer nobody took, or collects what came back.
          (resource.data.from == request.auth.uid && resource.data.status == 'open' && request.resource.data.status == 'cancelled')
          || (resource.data.from == request.auth.uid && resource.data.status == 'accepted' && request.resource.data.status == 'claimed')
          // Someone else takes an open offer, with the card it asks for (if it asks for one).
          || (resource.data.from != request.auth.uid && resource.data.status == 'open'
              && request.resource.data.status == 'accepted'
              && request.resource.data.to == request.auth.uid
              && (resource.data.want == null || request.resource.data.got == resource.data.want))
        );
    }

    // Curve Clash online (src/cloud/clash.ts): any signed-in player can look a game up and join it
    // while it has one player; only its two players can play it. Its field and players never change.
    match /clash/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null;
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && request.resource.data.seed == resource.data.seed
        && (
          (resource.data.guest == null && request.resource.data.guest == request.auth.uid)
          || ((request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
              && request.resource.data.guest == resource.data.guest)
        );
    }

    // Completed albums (src/cloud/albums.ts), told to every player: anyone can read them (players
    // without an account too); each signed-in player writes only their own, with the time it happened.
    match /albums/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'cards', 'at'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.cards is int
        && request.resource.data.at is int
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000;
    }

    // Friends and their collection scores (src/cloud/friends.ts). A friend code finds its player
    // (signed-in players look codes up; only its player makes or drops one); whoever adds a friend
    // leaves a note under the code, proof they had it.
    match /friendcodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /friendcodes/{code}/joins/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']);
    }
    // A score is read only by its player and their friends. Its player writes it; another player
    // only adds themselves to its friends (with a note under its current code, made in the same
    // write) or takes themselves off: friends are mutual.
    function scoreShapeOk(d) {
      return d.keys().hasOnly(['uid', 'name', 'avatar', 'frame', 'nameStyle', 'title', 'plush', 'code', 'friends', 'log', 'at'])
        && d.name is string && d.name.size() <= 40
        && (!('nameStyle' in d) || d.nameStyle == null || (d.nameStyle is string && d.nameStyle.size() <= 40))
        && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 40))
        && (!('plush' in d) || d.plush == null || (d.plush is string && d.plush.size() <= 40))
        && d.code is string && d.code.size() == 8
        && d.friends is list && d.friends.size() <= 30
        && d.log is map;
    }
    match /scores/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid in resource.data.friends);
      allow create: if request.auth != null && request.auth.uid == uid
        && scoreShapeOk(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.friends.size() == 0;
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && scoreShapeOk(request.resource.data)
          && request.resource.data.uid == uid)
        || (request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
          && request.resource.data.friends.size() <= 30
          && (
            // Joining: themselves added, nobody else, with proof they had the code.
            (request.resource.data.friends.toSet() == resource.data.friends.toSet().union([request.auth.uid].toSet())
              && existsAfter(/databases/$(database)/documents/friendcodes/$(resource.data.code)/joins/$(request.auth.uid)))
            // Leaving: themselves taken off, nobody else.
            || request.resource.data.friends.toSet() == resource.data.friends.toSet().difference([request.auth.uid].toSet())
          ))
      );
    }

    // The Daily Doodle (src/cloud/doodles.ts): doodles/<uid>_<day>. Its artist posts it once; only they and
    // their friends (their scores document's list) can read it. A friend guesses up to 3 times (their own
    // note under guesses/); a right guess adds them, and only them, to its solvers, in the same write.
    match /doodles/{id} {
      function artist() {
        return id.split('_')[0];
      }
      function isFriend() {
        return request.auth.uid in get(/databases/$(database)/documents/scores/$(artist())).data.friends;
      }
      allow get: if request.auth != null && (request.auth.uid == artist() || isFriend());
      allow create: if request.auth != null && request.auth.uid == artist()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'set', 'secs', 'answer', 'strokes', 'solvers', 'at'])
        && request.resource.data.uid == artist()
        && id == artist() + '_' + request.resource.data.day
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.secs in [10, 20, 30]
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 64
        && request.resource.data.strokes is list && request.resource.data.strokes.size() <= 400
        && request.resource.data.solvers.size() == 0;
      allow update: if request.auth != null && request.auth.uid != artist() && isFriend()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solvers'])
        && request.resource.data.solvers.toSet() == resource.data.solvers.toSet().union([request.auth.uid].toSet())
        && getAfter(/databases/$(database)/documents/doodles/$(id)/guesses/$(request.auth.uid)).data.right == true;
      match /guesses/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && uid != artist() && isFriend()
          && request.resource.data.keys().hasOnly(['tries', 'right', 'at'])
          && request.resource.data.tries == 1 && request.resource.data.right is bool;
        allow update: if request.auth != null && request.auth.uid == uid
          && resource.data.right == false
          && request.resource.data.keys().hasOnly(['tries', 'right', 'at'])
          && request.resource.data.tries == resource.data.tries + 1
          && request.resource.data.tries <= 3;
      }
    }

    // Group codes for the dailies (src/cloud/groups.ts). Anyone can look a code up (friends need no
    // account to join); a signed-in player makes their own; joining only counts one more friend, up to 12.
    match /groups/{code} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.joined == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined == resource.data.joined + 1
        && request.resource.data.joined <= 12;
    }

    // The daily gift, birthday and special-date rewards (src/cloud/rewards.ts). The birthday is written once and can
    // never be changed or removed; each reward is a claim document that can only be created once
    // (birthday-2026, christmas-2026...), at the server's time (the device's clock can't be faked in).
    // The coins are only added to the save after the claim was accepted. The dates here must match
    // src/data/rewards.json (npm run data:validate checks it).
    function rewardDates() {
      return { 'newyear': [1, 1], 'omnidle': [10, 18], 'halloween': [10, 31], 'christmas': [12, 25] };
    }
    // Days a special date's reward stays open (the day itself and the 6 after), as in rewards.json.
    function rewardWindowDays() {
      return 7;
    }
    // A day starts at UTC midnight; 14 hours early and 12 hours late cover every time zone.
    function hasBegun(t) {
      return request.time > t - duration.value(14, 'h');
    }
    function notOver(t) {
      return request.time < t + duration.value(12, 'h');
    }
    // A 29 February birthday falls on the 28th in other years.
    function birthdayIn(y, b) {
      return timestamp.date(y, b.month, (b.month == 2 && b.day == 29 && y % 4 != 0) ? 28 : b.day);
    }
    function birthdayClaimOk(uid, y) {
      return exists(/databases/$(database)/documents/rewards/$(uid))
        && hasBegun(birthdayIn(y, get(/databases/$(database)/documents/rewards/$(uid)).data))
        && notOver(timestamp.date(y + 1, 1, 1));
    }
    function dateClaimOk(name, y) {
      return name in rewardDates()
        && hasBegun(timestamp.date(y, rewardDates()[name][0], rewardDates()[name][1]))
        && notOver(timestamp.date(y, rewardDates()[name][0], rewardDates()[name][1]) + duration.value(rewardWindowDays(), 'd'));
    }
    // The daily gift (daily-2026-11-07): only on that day (by the server's clock, any time zone).
    function dailyClaimOk(id) {
      return id.matches('daily-[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && hasBegun(timestamp.date(int(id.split('-')[1]), int(id.split('-')[2]), int(id.split('-')[3])))
        && notOver(timestamp.date(int(id.split('-')[1]), int(id.split('-')[2]), int(id.split('-')[3])) + duration.value(1, 'd'));
    }
    function claimOk(uid, id) {
      return dailyClaimOk(id)
        || (id.matches('[a-z]+-[0-9]{4}')
          && (id.split('-')[0] == 'birthday'
            ? birthdayClaimOk(uid, int(id.split('-')[1]))
            : dateClaimOk(id.split('-')[0], int(id.split('-')[1]))));
    }
    match /rewards/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['month', 'day', 'at'])
        && request.resource.data.month is int && request.resource.data.month >= 1 && request.resource.data.month <= 12
        && request.resource.data.day is int && request.resource.data.day >= 1
        && request.resource.data.day <= [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][request.resource.data.month - 1]
        && request.resource.data.at == request.time;
      // No update, no delete: the birthday is for good.
    }
    match /rewards/{uid}/claims/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && claimOk(uid, id);
      // No update, no delete: a reward claimed stays claimed.
    }
  }
}
